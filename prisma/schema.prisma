datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  password     String
  role         Role
  images       String[]
  shortVideo   String?
  refreshToken String?
  name         String?
  age          Int?
  gender       Gender?
  location     Json? // GeoJSON format for geospatial queries

  // LLM
  rawProfile String? // Raw text input by user
  interests  String[]
  job        String?
  embeddings Float[] // Vector embeddings for semantic search

  // Form
  lookingFor          LookingFor?
  languages           String[]            @default([])
  zodiac              ZodiacSign?
  education           Education?
  futureFamily        FutureFamily?
  communicationStyle  CommunicationStyle?
  loveLanguage        LoveLanguage?
  pet                 Pets?
  alcoholConsumption  AlcoholConsumption?
  smoking             SmokingPreference?
  exerciseHabit       ExerciseFrequency?
  diet                DietaryPreference?
  socialMediaActivity SocialMediaUsage?
  sleepHabit          SleepPattern?

  // ====
  matchIDs    String[]     @db.ObjectId
  matches     Match[]      @relation(fields: [matchIDs], references: [id])
  preferences Preference[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  swipers        Swipe[]         @relation("swiper")
  targetUsers    Swipe[]         @relation("targetUser")
  searchSettings SearchSetting[]
}

model SearchSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  ageRange    Int[] // [minAge, maxAge]
  gender      Gender? // "male", "female", "other"
  maxDistance Int? // Khoảng cách tối đa (km)
  interests   String[] // Các sở thích ưu tiên
  hasBio      Boolean?

  lastUpdated DateTime @default(now())

  @@index([userId])
}

model Swipe {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  swiper       User      @relation("swiper", fields: [swiperId], references: [id])
  swiperId     String    @db.ObjectId
  targetUser   User      @relation("targetUser", fields: [targetUserId], references: [id])
  targetUserId String    @db.ObjectId
  direction    Direction
  createdAt    DateTime  @default(now())
}

model Match {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userIDs        String[] @db.ObjectId
  users          User[]   @relation(fields: [userIDs], references: [id])
  matchedAt      DateTime @default(now())
  stabilityScore Float? // Score from Gale-Shapley algorithm
}

model Preference {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  preferredOrder   String[] // Array of user IDs
  similarityScores Float[] // Array of similarity scores for each userID
  lastUpdated      DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

enum Direction {
  LEFT
  RIGHT
  UP
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

// User: Lưu trữ thông tin người dùng và embeddings.
// Swipe: Theo dõi hành vi swipe.
// Match: Lưu trữ các cặp đôi thành công.
// Preference: Danh sách ưu tiên cho thuật toán Gale-Shapley.

