datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  password        String
  role            Role
  images          String[]
  shortVideo      String?
  refreshToken    String?
  name            String?
  birthday        DateTime?
  gender          Gender?
  // location     Json? // GeoJSON format for geospatial queries
  likesCount      Int       @default(0) // Số lượt được like
  superLikesCount Int       @default(0) // Số lượt được super like

  // LLM
  rawProfile String? // Raw text input by user
  interests  Interest[]
  job        String?
  embeddings Float[] // Vector embeddings for semantic search

  // Form
  lookingFor          LookingFor?
  languages           String[]            @default([])
  zodiac              ZodiacSign?
  education           Education?
  futureFamily        FutureFamily?
  communicationStyle  CommunicationStyle?
  loveLanguage        LoveLanguage?
  pet                 Pets?
  alcoholConsumption  AlcoholConsumption?
  smoking             SmokingPreference?
  exerciseHabit       ExerciseFrequency?
  diet                DietaryPreference?
  socialMediaActivity SocialMediaUsage?
  sleepHabit          SleepPattern?

  balance Float @default(0)

  // ====
  matchIDs    String[]     @db.ObjectId
  matches     Match[]      @relation(fields: [matchIDs], references: [id])
  preferences Preference[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  swipers     Swipe[] @relation("swiper")
  targetUsers Swipe[] @relation("targetUser")

  lastIndexed DateTime? @default(now())
  latitude    Float?
  longitude   Float?

  vipSubscription  VipSubscription?
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")

  searchSetting SearchSetting?
}

model SearchSetting {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  ageRange          Int[] // [minAge, maxAge]
  gender            GenderPreference? // Giới tính mong muốn
  preferredDistance Int? // Khoảng cách mong muốn
  hasBio            Boolean? // Có tiểu sử không

  lastUpdated DateTime @default(now())
}

model Swipe {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  swiper       User      @relation("swiper", fields: [swiperId], references: [id])
  swiperId     String    @db.ObjectId
  targetUser   User      @relation("targetUser", fields: [targetUserId], references: [id])
  targetUserId String    @db.ObjectId
  direction    Direction
  isMatched    Boolean   @default(false) // Đánh dấu đã match hay chưa
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([swiperId])
  @@index([targetUserId])
  @@index([direction])
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Match {
  messages       Message[]
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userIDs        String[]    @db.ObjectId
  users          User[]      @relation(fields: [userIDs], references: [id])
  matchDate      DateTime    @default(now())
  stabilityScore Float? // Score from Gale-Shapley algorithm
  status         MatchStatus @default(PENDING)
  lastActivity   DateTime    @default(now())

  @@index([userIDs])
  @@index([status])
  @@index([matchDate])
}

model Message {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  senderId    String      @db.ObjectId
  receiverId  String      @db.ObjectId
  matchId     String?     @db.ObjectId
  content     String
  timestamp   DateTime    @default(now())
  read        Boolean     @default(false)
  messageType MessageType @default(TEXT)
  imageUrl    String?
  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  match       Match?      @relation(fields: [matchId], references: [id])
}

model Preference {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  preferredOrder   String[] // Array of user IDs
  similarityScores Float[] // Array of similarity scores for each userID
  priorityFactors  String[] // Array of priority factors
  lastUpdated      DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

model VipPackage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  duration  Int
  price     Float
  features  String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions VipSubscription[]
}

model VipSubscription {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @unique @db.ObjectId
  packageId     String   @db.ObjectId
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)
  paymentMethod String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vipPackage VipPackage @relation(fields: [packageId], references: [id])
}

enum MessageType {
  TEXT
  IMAGE
}

enum Direction {
  LEFT // Dislike
  RIGHT // Like
  UP // SuperLike
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum GenderPreference {
  MALE
  FEMALE
  BOTH
}

